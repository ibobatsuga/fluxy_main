# Fluxy CRM (apps/api, apps/web, packages/db) — copy this file to .env before `docker compose up`.
# Unrelated to fluxy-backend/.env or fluxy-frontend-main/.env, which are separate apps.

# Postgres (docker-compose service `postgres`)
POSTGRES_USER=fluxy
POSTGRES_PASSWORD=fluxy
POSTGRES_DB=fluxy_crm

# apps/api
# Generate a real secret for anything beyond local dev: openssl rand -base64 32
JWT_SECRET=dev-only-change-me

# WAHA (docker-compose service `waha`) — dev/self-hosted WhatsApp provider, see Fase 1.
WAHA_API_KEY=dev-only-key
