{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "fluxy-backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd fluxy-backend && php artisan serve --port=8000"],
      "port": 8000
    },
    {
      "name": "fluxy-frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd fluxy-frontend-main && npm run dev -- --port=5173"],
      "port": 5173
    }
  ]
}
