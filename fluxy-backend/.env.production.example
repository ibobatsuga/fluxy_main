APP_NAME=Fluxy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.fluxy.id
FRONTEND_URL=https://fluxy.id

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fluxy
DB_USERNAME=fluxy
DB_PASSWORD=

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

CORS_ALLOWED_ORIGINS=https://fluxy.id

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.fluxy.id/api/v1/auth/google/callback

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@fluxy.id
MAIL_FROM_NAME=Fluxy

PIXEL_IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_AI_TIMEOUT=90

MAYA_INSTAGRAM_PROVIDER=zernio
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1

MAYA_TIKTOK_PROVIDER=tiktok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://api.fluxy.id/api/v1/oauth/tiktok/callback

# Meta Graph API (store secrets in your hosting secret manager)
META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_HTTP_TIMEOUT=30
META_PUBLISH_STATUS_ATTEMPTS=10
META_PUBLISH_STATUS_DELAY_MS=1000
