APP_NAME=Fluxy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.fluxy.id
FRONTEND_URL=https://app.fluxy.id
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/fluxy/fluxy-backend/database/database.sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

CORS_ALLOWED_ORIGINS=https://app.fluxy.id
TRUSTED_PROXIES=127.0.0.1,::1
FLUXY_ADMIN_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.fluxy.id/api/v1/auth/google/callback

PIXEL_IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=4
CLOUDFLARE_AI_TIMEOUT=90

META_GRAPH_URL=https://graph.facebook.com
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
META_BUSINESS_ID=
META_SYSTEM_USER_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_HTTP_TIMEOUT=30
META_PUBLISH_STATUS_ATTEMPTS=10
META_PUBLISH_STATUS_DELAY_MS=1000

KAI_QR_GATEWAY_ENABLED=false
KAI_GATEWAY_WEBHOOK_SECRET=

# Optional. Never use documented/default passwords in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TENANT_EMAIL=
SEED_TENANT_PASSWORD=
